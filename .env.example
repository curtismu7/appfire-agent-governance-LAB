# This lab's own settings file (owner, 2026-11-09): copy this file to .env beside docker-compose.yml, then chmod 600 .env.
#   cp .env.example .env && chmod 600 .env
# .env is git-ignored and docker-ignored. The host run reads it from the repo root (not the working directory); Docker reads it only through
# ${...} substitution of the names docker-compose.yml lists (no env_file; a missing .env is fine). The lab needs none of it to open. Placeholder values only below: never commit a real one.

# AAG_LAB_MODE: leave empty. The lab then opens in Real when the Real settings below are complete and nothing refuses Real, and on its own steps
# otherwise (owner 2026-11-16). Set mock or live only to force one (tests and scripts do).
AAG_LAB_MODE=

# Extra host names the lab answers to, comma separated (the lab-proxy name). Empty: Docker uses its default from docker-compose.yml.
LAB_ALLOWED_HOSTS=

# Where the header "Shelf" button goes (the launcher). Leave empty to hide the button.
SHELF_URL=

# Real mode (owner only). PINGONE_ENVIRONMENT_ID and PINGONE_REGION (com, eu, ca or asia; com if unset) are used by both Real paths below.
PINGONE_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
PINGONE_REGION=com

# FULL Real (owner, 2026-11-10): a real sign-in (pi.flow, in the Sign in dialog), the agent's own token, an RFC 8693 token exchange and a tool server over MCP.
# Real is available when ALL of these are filled (and PINGONE_ENVIRONMENT_ID above). Once ANY of them is filled, the old
# PINGONE_CLIENT_* path below is ignored entirely. The demo user's PASSWORD is never stored here: the person types it in the Sign in dialog.
# The user app must list this redirect URI (pi.flow never redirects; PingOne only checks it): http://127.0.0.1:5603/callback (scripts/owner/pingone-real-setup.mjs registers it)
# The issuer is always YOUR PingOne (PingFederate is not wired in yet). The software vertical runs on the lab's own tool server, which ships in this image and
# checks your PingOne's tokens against its published keys: no SE gateway is needed for it.
AAG_USER_CLIENT_ID=00000000-0000-0000-0000-000000000000
AAG_USER_CLIENT_SECRET=replace-me
AAG_AGENT_CLIENT_ID=00000000-0000-0000-0000-000000000000
AAG_AGENT_CLIENT_SECRET=replace-me
AAG_DEMO_USERNAME=demo.user@example.invalid

# Optional: the SE Agent Gateway (banking, healthcare, retail). All three together, or none: with none, those use cases run whole on the lab's own
# steps. Placeholders below count as not set.
AAG_AGENT_GATEWAY_URL=https://agent-gateway.example/mcp
AAG_GATEWAY_AUDIENCE=replace-me
AAG_GATEWAY_SCOPE=replace-me

# Optional: which provider answers a Real run. auto (the default): an SE provider when its settings are present and a health probe passes, else the lab's own
# tool server; se: only SE; local: only the lab's own tool server. Chosen once per run. Read from this file (a shell variable is not read on a host run).
# AAG_PROVIDER=auto
# Optional: the tools resource in PingOne. The audience the tool server requires (default appfire-work-tools), the group that means the premium tier
# (default Software_EnterpriseTier), the group that means the airline vertical's premium tier (default Airline_OrbitTier), and the MCP endpoint of an SE-hosted copy of the tool server (nothing is deployed there today).
# AAG_TOOLS_AUDIENCE=appfire-work-tools
# AAG_TOOLS_TIER_GROUP=Software_EnterpriseTier
# AAG_TOOLS_TIER_GROUP_AIRLINE=Airline_OrbitTier
# AAG_TOOLS_SE_URL=https://tools.example/mcp
# Optional: the scope of the agent token and of token exchange 1 (the resource that owns it stamps act = the agent into the token). Leave it out for
# the default, agent:invoke. One scope name, not the gateway scope. The owner setup script writes it into this file only when it is not the default.
# AAG_AGENT_SCOPE=agent:invoke

# Optional, Real A2A (agent to agent; AI-DEMO2's a2aDelegationService): the specialist agent's own PingOne app (banking's Investment Advisor) and the two
# audiences and scopes of the chained exchange. All six together turn on the chained exchange for UC2 and UC2.5 in Real; with none set (or only some) those
# use cases run the labelled mock engine. AAG_A2A_AGENT_TOKEN_AUTH=CLIENT_SECRET_POST when the specialist app uses it (leave empty for Basic).
# AAG_A2A_AGENT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AAG_A2A_AGENT_CLIENT_SECRET=replace-me
# AAG_A2A_AGENT_TOKEN_AUTH=
# AAG_A2A_INTERMEDIATE_AUDIENCE=replace-me
# AAG_A2A_INTERMEDIATE_SCOPE=agent:invoke:investment
# AAG_A2A_GATEWAY_AUDIENCE=replace-me
# AAG_A2A_SCOPE=invest:read

# Optional, PingOne Authorize decides the airline booking (owner, 2026-11-17). The decision endpoint's id (the endpoint "Larkspur Air Booking", "Use latest" on) and the id and secret of a
# WORKER-type PingOne app made for this lab. All three together turn it on (the environment id and region come from PINGONE_* above): the lab's tool server then asks PingOne Authorize for
# each airline booking decision and applies its answer, and the page says "PingOne Authorize decided" only when it did. With none set, the lab's own fare rule answers and says so.
# Some of them set is a named problem and nothing is asked. The secret is write-only: it stays in the lab's main process (never in the tool server process, a hop, a log or an answer).
# AAG_AUTHORIZE_ENDPOINT_ID=00000000-0000-0000-0000-000000000000
# AAG_AUTHORIZE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AAG_AUTHORIZE_CLIENT_SECRET=replace-me

# OLD Real, identity provider only (two calls: discovery and a client-credentials token). Used ONLY while none of the AAG_* names above is filled.
# PINGONE_CLIENT_ID/SECRET are a worker client and are never used for the user or agent flow. Placeholders below count as not set.
PINGONE_CLIENT_ID=00000000-0000-0000-0000-000000000000
PINGONE_CLIENT_SECRET=replace-me

# Real OFF switch (Docker takes it from this file, the host run from the shell): 0 turns Real off even with the settings above.
# AAG_ALLOW_LIVE=0

# Per-run shell settings, NOT read from this file by the host run:
# PORT=7814                       # must be in 7814-5699 (Docker publishes 5603 by default)
# CALAB_BIND=127.0.0.1            # loopback only unless you set this on purpose (the container does)
# ALLOW_MOCK_SIGNIN=1             # the owner's opt-in to the mock persona sign-in (scripts/run.sh and Docker set it)
# IDP=                           # unset (default): Mock uses the mock IdP, Real uses PingOne. mock pins Mock; pingone pins Real (mock sign-in off).
# AAG_ENV_FILE=/path/to/other.env # tests and e2e only: read another file instead of this app's .env
# AAG_LIVE_TEST_BASE=http://127.0.0.1:<port>/<environment id>   # tests and e2e only: a fake PingOne on loopback

AAG_AGENT_TOKEN_AUTH=
# REAL human-approval (HITL) on the SE gateway: the SE HITL service the Agent Gateway mints challenges with. The lab's phone records
# the human's answer with it (POST /challenges/:id/respond, X-HITL-Internal-Secret) and the gateway verifies the receipt
# on the retry. Without these, an SE hold still shows, but an approval cannot be recorded (fail closed). Only a URL set here is allowed through the netguard.
# The lab's own tool server needs none of this: it has its own approval service inside the container.
# AAG_HITL_SERVICE_URL=https://hitl.example
# AAG_HITL_INTERNAL_SECRET=
